    "### Test Case 3: Restructured Portfolio Analysis"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 32,
   "metadata": {
    "id": "cjB1-8hUTKLk"
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "[1] Intent Classification: route=generated, query_id=None\n",
      "    Reason: The question requires a specific list of restructured loans with impairment flags, which is not covered by any verified template.\n",
      "[2] Query Construction: generated fresh SQL\n",
      "[3] Validation Gate: passed=True, relevance_confidence=0.9\n",
      "[4] Execute: 35 rows returned\n",
      "[6] Response Generation: confidence=0.9\n"
     ]
    }
   ],
   "source": [
    "test_3 = run_pipeline(ground_truth['User Query'].iloc[2], conn, verified_query_library, database_schema) "
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {
    "id": "wDq42QbRTKLl"
   },
   "source": [
    "**Response:**"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 33,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Confidence: 0.9\n",
      "\n",
      "Narrative:\n",
      "The total number of restructured loans is 35, with 24 loans flagged as impaired, resulting in an impaired percentage of 68.571429%. The impaired loans include those classified as Substandard, Doubtful, and Loss, indicating a significant portion of the restructured portfolio is under distress.\n",
      "\n",
      "Executed SQL:\n",
      "SELECT \n",
      "    lm.loan_account_number,\n",
      "    lm.borrower_name,\n",
      "    lm.product_type,\n",
      "    lm.sanctioned_amount / 1e6 AS sanctioned_amount_mn,\n",
      "    lm.disbursed_amount / 1e6 AS disbursed_amount_mn,\n",
      "    lm.outstanding_principal / 1e6 AS outstanding_principal_mn,\n",
      "    lm.outstanding_interest / 1e6 AS outstanding_interest_mn,\n",
      "    lm.total_outstanding / 1e6 AS total_outstanding_mn,\n",
      "    lm.days_past_due,\n",
      "    lm.asset_classification,\n",
      "    CASE \n",
      "        WHEN lm.asset_classification IN ('Substandard', 'Doubtful', 'Loss') THEN 1 \n",
      "        ELSE 0 \n",
      "    END AS is_impaired,\n",
      "    COUNT(*) OVER () AS total_restructured_loans_count,\n",
      "    SUM(CASE \n",
      "        WHEN lm.asset_classification IN ('Substandard', 'Doubtful', 'Loss') THEN 1 \n",
      "        ELSE 0 \n",
      "    END) OVER () * 100.0 / COUNT(*) OVER () AS impaired_percentage_pct,\n",
      "    sm.sector_name\n",
      "FROM \n",
      "    loan_master lm\n",
      "JOIN \n",
      "    sector_master sm ON lm.sector_code = sm.sector_code\n",
      "WHERE \n",
      "    lm.is_restructured = 1\n",
      "ORDER BY \n",
      "    lm.loan_account_number;\n",
      "\n",
      "Result data:\n"
     ]
    },
